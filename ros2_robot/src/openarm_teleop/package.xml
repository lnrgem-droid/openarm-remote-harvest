<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_teleop</name>
  <version>0.1.0</version>
  <description>Leader-follower bilateral/unilateral teleoperation for OpenArm.</description>
  <maintainer email="openarm@enactic.ai">OpenArm</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>kdl_parser</depend>

  <build_depend>liborocos-kdl-dev</build_depend>
  <build_depend>libeigen3-dev</build_depend>
  <build_depend>liburdfdom-dev</build_depend>
  <build_depend>libyaml-cpp-dev</build_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>openarm_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
