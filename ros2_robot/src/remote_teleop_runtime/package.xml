  <version>0.1.0</version>
  <description>ROS2/UDP runtime for staged OpenArm remote teleoperation.</description>
  <maintainer email="openarm@todo.todo">openarm</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
